#!/bin/zsh
# claude-usage — 여러 클로드 계정의 사용량(주간·5시간 세션)을 한 번에 조회합니다. macOS 전용.
#
#   claude-usage add <이름>      계정 등록 (claude setup-token으로 받은 토큰을 키체인에 저장)
#   claude-usage                 모든 계정 조회 → 표로 보여 주고 결과를 클립보드에 복사
#   claude-usage list            등록된 계정 이름
#   claude-usage remove <이름>   계정 삭제 (키체인에서도 지움)
#   claude-usage copy            마지막 조회 결과를 다시 복사
#   claude-usage schedule on|off 1시간마다 자동 조회 + 알림 켜기/끄기
#
# 토큰은 macOS 키체인(서비스 이름 "claude-usage")에만 저장하고, 파일에는 계정 이름만 적습니다.
# 사용량은 Claude Code의 /usage가 쓰는 공개되지 않은 주소에서 읽기 때문에 바뀌면 고쳐야 할 수 있어요.

emulate -L zsh
setopt pipefail

readonly VERSION=1
readonly SELF=${0:A}  # inside functions $0 is the function name
readonly SERVICE=claude-usage
readonly DIR="$HOME/.config/claude-usage"
readonly ACCOUNTS="$DIR/accounts"
readonly LAST="$DIR/last.json"
readonly USAGE_URL="https://api.anthropic.com/api/oauth/usage"
readonly PLIST="$HOME/Library/LaunchAgents/kr.memoryz.claude-usage.plist"
readonly DAYS=(일 월 화 수 목 금 토)

if [[ -t 1 ]]; then
  B=$'\e[1m' D=$'\e[2m' R=$'\e[0m' BLUE=$'\e[34m' RED=$'\e[31m' YEL=$'\e[33m' GRN=$'\e[32m'
else
  B= D= R= BLUE= RED= YEL= GRN=
fi

die() { print -u2 -- "${RED}$*${R}"; exit 1; }
mkdir -p "$DIR" && touch "$ACCOUNTS"

names() { grep -v '^[[:space:]]*$' "$ACCOUNTS"; }
has_name() { names | grep -qxF -- "$1"; }
token_for() { security find-generic-password -s "$SERVICE" -a "$1" -w 2>/dev/null; }

# Prints the HTTP status on the first line and the body after it.
fetch_usage() {
  local token=$1 out
  out=$(curl -sS --max-time 20 -w $'\n%{http_code}' \
    -H "Authorization: Bearer $token" \
    -H "anthropic-beta: oauth-2025-04-20" \
    -H "Accept: application/json" \
    -H "User-Agent: claude-usage/$VERSION" \
    "$USAGE_URL" 2>&1) || { print -- "000"; print -- "$out"; return; }
  print -- "${out##*$'\n'}"
  print -- "${out%$'\n'*}"
}

explain_status() {
  case $1 in
    401) print -- "토큰이 만료됐거나 끊겼어요. claude-usage add 로 다시 등록하세요." ;;
    403) print -- "이 토큰으로는 사용량을 볼 수 없어요(권한 없음)." ;;
    429) print -- "요청이 너무 잦아요. 잠시 뒤 다시 시도하세요." ;;
    000) print -- "인터넷 연결을 확인하세요." ;;
    *) print -- "응답 코드 $1" ;;
  esac
}

# Usage JSON → "weeklyPct weeklyResetEpoch sessionPct sessionResetEpoch", "-" where missing.
# Uses macOS's built-in JavaScript, since the response holds nulls that plutil can't read.
parse_usage() {
  osascript -l JavaScript -e '
    function run(argv) {
      var j = JSON.parse(argv[0]);
      function pct(k) { var o = j[k]; return o && o.utilization != null && isFinite(o.utilization) ? String(Number(o.utilization)) : "-"; }
      function at(k) { var o = j[k]; var t = o && o.resets_at ? Date.parse(o.resets_at) : NaN; return isNaN(t) ? "-" : String(Math.floor(t / 1000)); }
      return [pct("seven_day"), at("seven_day"), pct("five_hour"), at("five_hour")].join(" ");
    }' "$1" 2>/dev/null || print -- "- - - -"
}

human_left() {
  local s=$1 d h m
  (( s < 60 )) && { print -- "곧"; return; }
  d=$(( s / 86400 )) h=$(( s % 86400 / 3600 )) m=$(( s % 3600 / 60 ))
  if (( d > 0 )); then print -- "${d}일 ${h}시간"
  elif (( h > 0 && m > 0 )); then print -- "${h}시간 ${m}분"
  elif (( h > 0 )); then print -- "${h}시간"
  else print -- "${m}분"; fi
}

when() {
  local e=$1 m d w
  m=$(date -r $e +%m) d=$(date -r $e +%d) w=$(date -r $e +%w)
  print -- "$(( 10#$m ))/$(( 10#$d ))(${DAYS[$(( w + 1 ))]}) $(date -r $e +%H:%M)"
}

bar() {
  local pct=${1%.*} width=20 fill i out=
  (( pct < 0 )) && pct=0
  (( pct > 100 )) && pct=100
  fill=$(( (pct * width + 50) / 100 ))
  for (( i = 0; i < width; i++ )); do (( i < fill )) && out+="█" || out+="░"; done
  print -- "$out"
}

color_for() {
  local pct=${1%.*}
  if (( pct >= 90 )); then print -- $RED
  elif (( pct >= 70 )); then print -- $YEL
  else print -- $BLUE; fi
}

json_escape() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; print -- "$s"; }

# One limit line: label, percent, reset.
show_limit() {
  local label=$1 pct=$2 e=$3 now=$4 left
  if [[ $pct == - ]]; then
    printf "  %-8s ${D}정보 없음${R}\n" "$label"
    return
  fi
  local c=$(color_for $pct)
  if [[ $e != - ]]; then
    left=$(( e - now ))
    printf "  %-8s ${c}%s${R} ${B}%5.1f%%${R}  ${D}%s 초기화 · %s 남음${R}\n" "$label" "$(bar $pct)" "$pct" "$(when $e)" "$(human_left $left)"
  else
    printf "  %-8s ${c}%s${R} ${B}%5.1f%%${R}  ${D}진행 중인 세션 없음${R}\n" "$label" "$(bar $pct)" "$pct"
  fi
}

cmd_add() {
  local name=$1 token answer resp code body
  [[ -z $name ]] && read -r "name?계정 이름 (예: quaternary2026): "
  [[ -z $name ]] && die "이름이 필요해요."
  [[ $name == *$'\n'* || $name == *'"'* ]] && die "이름에 따옴표나 줄바꿈은 쓸 수 없어요."

  print -- ""
  print -- "${B}[$name] 계정 등록${R}"
  print -- "1) 브라우저의 claude.ai에 ${B}$name${R} 계정으로 로그인돼 있는지 먼저 확인하세요."
  print -- "2) claude setup-token 이 브라우저를 열어 로그인을 마치면, 터미널에 sk-ant-로 시작하는 토큰이 나와요."
  print -- ""
  if command -v claude >/dev/null; then
    read -r "answer?지금 claude setup-token 을 실행할까요? [Y/n] "
    [[ $answer != [nN]* ]] && claude setup-token
  else
    print -- "${YEL}claude 명령을 찾지 못했어요. Claude Code를 설치한 뒤 다른 창에서 claude setup-token 을 실행하세요.${R}"
  fi
  print -- ""
  read -rs "token?토큰을 붙여 넣고 Enter (화면에 보이지 않아요): "
  print -- ""
  token=${token//[[:space:]]/}
  [[ $token == sk-ant-* ]] || die "sk-ant-로 시작하는 토큰이 아니에요. 다시 시도하세요."

  print -- "확인 중…"
  resp=$(fetch_usage "$token")
  code=${resp%%$'\n'*}
  body=${resp#*$'\n'}
  if [[ $code != 200 ]]; then
    print -u2 -- "${RED}사용량을 읽지 못해 저장하지 않았어요: $(explain_status $code)${R}"
    print -u2 -- "${D}응답: ${body[1,200]}${R}"
    exit 1
  fi
  security add-generic-password -U -s "$SERVICE" -a "$name" -l "claude-usage: $name" -w "$token" || die "키체인에 저장하지 못했어요."
  has_name "$name" || print -- "$name" >> "$ACCOUNTS"
  print -- "${GRN}✓ $name 등록 완료.${R} 이제 ${B}claude-usage${R} 로 조회하세요."
}

cmd_remove() {
  local name=$1
  [[ -z $name ]] && die "삭제할 이름을 적어 주세요: claude-usage remove <이름>"
  has_name "$name" || die "$name 은(는) 등록돼 있지 않아요."
  security delete-generic-password -s "$SERVICE" -a "$name" >/dev/null 2>&1
  names | grep -vxF -- "$name" > "$ACCOUNTS.tmp"; mv "$ACCOUNTS.tmp" "$ACCOUNTS"
  print -- "$name 을(를) 삭제했어요."
}

cmd_list() {
  local i=0 n
  names | while read -r n; do i=$(( i + 1 )); print -- "계정 $i  $n"; done
  [[ -s $ACCOUNTS ]] || print -- "등록된 계정이 없어요. claude-usage add <이름> 으로 추가하세요."
}

cmd_check() {
  local copy=1 notify=0 quiet=0 arg
  for arg in "$@"; do
    case $arg in
      --no-copy) copy=0 ;;
      --notify) notify=1 ;;
      --quiet) quiet=1 ;;
    esac
  done
  local -a list=("${(@f)$(names)}")
  [[ -z ${list[1]} ]] && die "등록된 계정이 없어요. 먼저 claude-usage add <이름> 을 실행하세요."

  local now=$(date +%s) i=0 name token resp code body why wp we sp se
  local entries=() alerts=()
  for name in $list; do
    i=$(( i + 1 ))
    (( quiet )) || print -- "\n${B}계정 $i${R}  ${B}$name${R}"
    token=$(token_for "$name")
    if [[ -z $token ]]; then
      (( quiet )) || print -- "  ${RED}키체인에 토큰이 없어요. claude-usage add $name${R}"
      entries+=("{\"name\":\"$(json_escape $name)\",\"error\":\"키체인에 토큰이 없어요\"}")
      continue
    fi
    resp=$(fetch_usage "$token")
    code=${resp%%$'\n'*}
    body=${resp#*$'\n'}
    if [[ $code != 200 ]]; then
      why=$(explain_status $code)
      (( quiet )) || print -- "  ${RED}$why${R}"
      entries+=("{\"name\":\"$(json_escape $name)\",\"error\":\"$(json_escape $why)\"}")
      continue
    fi
    read -r wp we sp se <<< "$(parse_usage "$body")"
    if (( ! quiet )); then
      show_limit "주간" "$wp" "$we" $now
      show_limit "5시간" "$sp" "$se" $now
    fi
    entries+=("{\"name\":\"$(json_escape $name)\",\"usage\":$body}")

    if [[ $wp != - ]]; then
      if (( ${wp%.*} >= 90 )); then alerts+=("$name 주간 ${wp%.*}% 사용")
      elif [[ $we != - ]] && (( we - now < 86400 && 100 - ${wp%.*} >= 30 )); then alerts+=("$name $(( 100 - ${wp%.*} ))% 남았는데 $(human_left $(( we - now ))) 뒤 초기화"); fi
    fi
  done

  local json="{\"source\":\"claude-usage\",\"version\":$VERSION,\"fetchedAt\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"accounts\":[${(j:,:)entries}]}"
  print -r -- "$json" > "$LAST"
  if (( copy )); then
    print -rn -- "$json" | pbcopy
    (( quiet )) || print -- "\n${GRN}✓ 클립보드에 복사했어요.${R} 관리 페이지에서 ${B}Cmd+V${R} 하면 한 번에 반영돼요."
  fi
  if (( notify && ${#alerts} )); then
    osascript -e "display notification \"${(j:\n:)alerts}\" with title \"클로드 사용량\"" >/dev/null 2>&1
  fi
}

cmd_copy() {
  [[ -s $LAST ]] || die "아직 조회한 적이 없어요. claude-usage 를 먼저 실행하세요."
  print -rn -- "$(<$LAST)" | pbcopy
  print -- "마지막 조회 결과($(date -r $(stat -f %m "$LAST") '+%m/%d %H:%M'))를 복사했어요."
}

cmd_schedule() {
  case $1 in
    on)
      mkdir -p "${PLIST:h}"
      cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>kr.memoryz.claude-usage</string>
  <key>ProgramArguments</key><array>
    <string>/bin/zsh</string><string>$SELF</string><string>check</string>
    <string>--no-copy</string><string>--notify</string><string>--quiet</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
</dict></plist>
EOF
      launchctl bootout "gui/$UID" "$PLIST" >/dev/null 2>&1
      launchctl bootstrap "gui/$UID" "$PLIST" && print -- "1시간마다 자동 조회를 켰어요. 결과는 claude-usage copy 로 언제든 복사할 수 있어요."
      ;;
    off)
      launchctl bootout "gui/$UID" "$PLIST" >/dev/null 2>&1
      rm -f "$PLIST"
      print -- "자동 조회를 껐어요."
      ;;
    *) die "claude-usage schedule on 또는 off" ;;
  esac
}

cmd_help() {
  sed -n '2,13p' "$SELF" | sed 's/^# \{0,1\}//'
}

[[ $OSTYPE == darwin* ]] || die "macOS에서만 동작해요."
case $1 in
  add) shift; cmd_add "$@" ;;
  remove|rm) shift; cmd_remove "$@" ;;
  list|ls) cmd_list ;;
  copy) cmd_copy ;;
  schedule) shift; cmd_schedule "$@" ;;
  help|-h|--help) cmd_help ;;
  check) shift; cmd_check "$@" ;;
  ""|--*) cmd_check "$@" ;;
  *) die "모르는 명령: $1  (claude-usage help)" ;;
esac
