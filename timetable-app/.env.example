# 복사해서 .env 로 저장하세요 (start 스크립트가 처음 한 번 자동으로 만들어 줍니다)

# AI 계획 세우기용 Claude API 키 — https://console.anthropic.com 에서 발급
# 이 키는 컴퓨터에서 도는 AI 서버(server/)만 읽고, 앱에는 들어가지 않습니다.
ANTHROPIC_API_KEY=

# 앱이 접속할 AI 서버 주소
# - 컴퓨터 브라우저에서 볼 때: 그대로 두세요
# - 휴대폰(Expo Go)에서 볼 때: localhost 대신 이 컴퓨터의 IP (예: http://192.168.0.12:8788)
# - GCP 등 다른 서버를 쓸 때: 그 서버 주소 (README의 "AI 서버 API" 형식을 따라야 합니다)
EXPO_PUBLIC_PLANNER_API_URL=http://localhost:8788

# 선택: AI 서버 포트
# PLANNER_PORT=8788
