# 복사해서 .env 로 저장하세요 (cp .env.example .env)

# Claude 멤버용 — https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
# 지피티 멤버용 — https://platform.openai.com/api-keys 에서 발급 (ChatGPT 로그인 계정과는 별개)
OPENAI_API_KEY=

# 휴대폰 등 다른 기기에서 들어올 때 쓰는 방 비밀번호. 꼭 정하세요.
ROOM_PASSWORD=

# 선택 사항
# PORT=8787
# HOST=127.0.0.1   # 이 컴퓨터에서만 쓰려면

# 멤버별 모델·직급은 화면의 프로필 → 모델 설정에서 바꿉니다 (data/room.json 에 저장)
