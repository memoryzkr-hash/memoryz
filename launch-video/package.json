{
  "name": "tally-launch-video",
  "private": true,
  "version": "0.1.0",
  "description": "35s Tally launch motion graphic, built with Remotion",
  "scripts": {
    "sound": "tsx scripts/soundtrack.ts",
    "predev": "npm run sound",
    "dev": "remotion studio",
    "still": "remotion still",
    "prerender": "npm run sound",
    "render": "remotion render Video out/video.mp4",
    "render:4k": "npm run sound && remotion render Video out/video-4k.mp4 --scale=2",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.532",
    "@remotion/fonts": "^4.0.532",
    "@remotion/motion-blur": "^4.0.532",
    "react": "19.2",
    "react-dom": "19.2",
    "remotion": "^4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
