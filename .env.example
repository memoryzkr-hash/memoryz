# 보통은 직접 만들 필요 없어요: npm run promo:app 화면의 "계정 연결"이 이 파일(.env)을 대신 채워요. .env는 git에 올라가지 않아요.
# 손으로 채우려면 복사해서 .env로 저장하세요. GitHub Actions에서는 Settings → Secrets에 같은 이름으로 넣습니다. 설명: docs/promo/LOCAL.md · SETUP.md

ANTHROPIC_API_KEY=
THREADS_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
# 페이스북 로그인 방식일 때만:
# INSTAGRAM_API_HOST=graph.facebook.com
# INSTAGRAM_USER_ID=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
PROMO_SECRET_KEY=
NOTIFY_WEBHOOK_URL=

# 카드 이미지를 GitHub에 올리려면 (로컬에서는 보통 비워 두고 preview만 씁니다):
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=내아이디/저장소

# 이미 설치된 크롬/크로미움을 쓰려면:
# PROMO_CHROMIUM_PATH=/path/to/chrome
